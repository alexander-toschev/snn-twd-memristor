{
  "dataset": "cifar10",
  "data_dir": "data",
  "n_classes": 10,
  "T": 12,
  "x_min": 0.1,
  "c1_out": 64,
  "c2_out": 128,
  "c3_out": 256,
  "fc1_out": 512,
  "n_conv_layers": 3,
  "tau": 0.5,
  "v_threshold": 1.0,
  "surrogate_alpha": 2.0,
  "epochs": 200,
  "batch_size": 32,
  "lr": 0.0005,
  "weight_decay": 0.0001,
  "lr_scheduler": "cosine",
  "warmup_epochs": 5,
  "dropout_fc": 0.3,
  "loss_mode": "tet",
  "fsl_weight": 0.5,
  "tet_weight": 1.0,
  "use_twd": true,
  "twd_weight": 0.1,
  "use_bntt": true,
  "use_greedy": false,
  "use_eprop": false,
  "seed": 0,
  "outdir": "runs_csnn",
  "device": "cuda",
  "num_workers": 2,
  "pin_memory": true,
  "save_every": 20
}
